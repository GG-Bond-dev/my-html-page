function calcResult() {
  let E=0, I=0, S=0, N=0, T=0, F=0, J=0, P=0;
  answers.forEach((a, i) => {
    if(i%4===0) (a=='B' || a=='C') ? E++ : I++;
    if(i%4===1) (a=='A' || a=='C') ? S++ : N++;
    if(i%4===2) (a=='A' || a=='D') ? T++ : F++;
    if(i%4===3) (a=='A' || a=='C') ? J++ : P++;
  });
  const typeStr = (E >= I ? 'E' : 'I') + (S >= N ? 'S' : 'N') + (T >= F ? 'T' : 'F') + (J >= P ? 'J' : 'P');
  const res = karmeTypes[typeStr] || karmeTypes["ISTJ"];

  document.getElementById('typeName').innerText = res.name;
  document.getElementById('typeDesc').innerText = res.desc;
  
  const imgElement = document.getElementById('karmiImg');
  imgElement.crossOrigin = "anonymous"; 
  imgElement.src = res.img + "?t=" + new Date().getTime(); 

  document.getElementById('keyTags').innerHTML = res.tags.map(t => `<span class="tag"># ${t}</span>`).join('');
  
  let dimHtml = '';
  for(let k in res.dim) {
    const v = res.dim[k];
    dimHtml += `<div class="dim-item"><span>${k}</span><div class="dim-bar"><div class="dim-fill" style="width:${v}%"></div></div><span>${v}</span></div>`;
  }
  document.getElementById('dimList').innerHTML = dimHtml;
  document.getElementById('fullAnalysis').innerText = res.analysis;
  
  document.querySelector('.progress').style.display = 'none';
  document.getElementById('result').style.display = 'block';
  window.scrollTo(0, 0);
}

function saveImg() {
  const target = document.getElementById('result');
  const btns = document.getElementById('final-btns');
  
  // 保存前临时隐藏按钮，避免按钮出现在海报中
  btns.style.display = 'none';
  
  html2canvas(target, { 
    useCORS: true, 
    backgroundColor: "#f2f9ff",
    scale: 2 
  }).then(canvas => {
    const link = document.createElement('a');
    link.download = '我的卡米形态测试结果.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
    btns.style.display = 'flex'; // 保存后恢复显示
  });
}
